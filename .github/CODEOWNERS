# ==============================================================================
# TeamFlow Repository CODEOWNERS
# ==============================================================================
# This file defines individuals or teams responsible for reviewing code changes.
# GitHub automatically requests review from owners when a PR touches these paths.
#
# Format reference:
# https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners
# ==============================================================================

# Global fallback: Default owner for all files across TeamFlow
* @Asta-Builds

# ==============================================================================
# RED ZONE: Database Schemas & Migrations (MANDATORY APPROVAL)
# Modifying schemas or migrations carries high risk of database corruption or drift.
# ==============================================================================

# Prisma schema & generator definitions (NestJS API Gateway)
/backend-nest/prisma/                         @Asta-Builds
/backend-nest/prisma/schema.prisma            @Asta-Builds

# Django Migrations: Wildcard pattern & all 11 individual app migration trees
/backend/*/migrations/                        @Asta-Builds
/backend/accounts/migrations/                 @Asta-Builds
/backend/agents/migrations/                   @Asta-Builds
/backend/deployments/migrations/              @Asta-Builds
/backend/integrations/migrations/             @Asta-Builds
/backend/notifications/migrations/            @Asta-Builds
/backend/organizations/migrations/            @Asta-Builds
/backend/projects/migrations/                 @Asta-Builds
/backend/pulse/migrations/                    @Asta-Builds
/backend/queues/migrations/                   @Asta-Builds
/backend/seo/migrations/                      @Asta-Builds
/backend/tasks/migrations/                    @Asta-Builds

# ==============================================================================
# RED ZONE: CI/CD Workflows, Automation & Ownership Guardrails
# Workflows control deployment pipelines, security secrets, and gate automation.
# ==============================================================================

/.github/                                     @Asta-Builds
/.github/CODEOWNERS                           @Asta-Builds
/.github/workflows/                           @Asta-Builds
/.github/workflows/*                          @Asta-Builds
/.github/workflows/*.yml                      @Asta-Builds
/.github/workflows/*.yaml                     @Asta-Builds

# ==============================================================================
# RED ZONE: Docker & Container Infrastructure
# Controls runtime base images, port allocations, secrets, and deployment artifacts.
# ==============================================================================

# Compose manifests
/docker-compose*.yml                          @Asta-Builds
/docker-compose.yml                           @Asta-Builds
/docker-compose.prod.yml                      @Asta-Builds

# Docker ignore files
/.dockerignore                                @Asta-Builds
/backend/.dockerignore                        @Asta-Builds
/backend-nest/.dockerignore                   @Asta-Builds
/frontend/.dockerignore                       @Asta-Builds

# Container definition files
Dockerfile                                    @Asta-Builds
**/Dockerfile                                 @Asta-Builds
/backend/Dockerfile                           @Asta-Builds
/backend-nest/Dockerfile                      @Asta-Builds
/frontend/Dockerfile                          @Asta-Builds
/nginx/Dockerfile                             @Asta-Builds
/deploy-receiver/Dockerfile                   @Asta-Builds

# Container entrypoints
/backend/docker-entrypoint.sh                 @Asta-Builds

# ==============================================================================
# RED ZONE: Nginx Reverse Proxy Configuration
# Reverse proxy routing rules, SSL termination, and SSE streaming endpoints.
# ==============================================================================

/nginx/                                       @Asta-Builds
/nginx/*                                      @Asta-Builds
/nginx/default.conf                           @Asta-Builds
/nginx/nginx.conf                             @Asta-Builds
/nginx/railway-entrypoint.sh                  @Asta-Builds
/nginx/railway.conf.template                  @Asta-Builds

# ==============================================================================
# RED ZONE: Core Architecture & Authentication
# Security boundaries, JWT verification, session tokens, and core settings.
# ==============================================================================

# Core Django settings, URLs, WSGI/ASGI entrypoints, and permissions
/backend/teamflow/                            @Asta-Builds
/backend/teamflow/settings.py                 @Asta-Builds
/backend/teamflow/urls.py                     @Asta-Builds
/backend/teamflow/asgi.py                     @Asta-Builds
/backend/teamflow/wsgi.py                     @Asta-Builds
/backend/teamflow/celery.py                   @Asta-Builds
/backend/teamflow/permissions.py              @Asta-Builds
/backend/teamflow/admin_operations.py         @Asta-Builds

# Core NestJS Auth Module
/backend-nest/src/auth/                       @Asta-Builds
/backend-nest/src/modules/auth/               @Asta-Builds

