/backend-nest/eslint.legacy.mjs               @Asta-Builds
/.jscpd.json                                  @Asta-Builds
/frontend/knip.json                           @Asta-Builds
/backend-nest/knip.json                       @Asta-Builds
/.githooks/                                   @Asta-Builds
