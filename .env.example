# Copy this file to .env and set every required value before starting Compose.
# Values are intentionally blank: no credentials, tenant names, URLs, or ports are baked into runtime config.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=
REDIS_URL=
CELERY_BROKER_URL=

DJANGO_SECRET_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
DEBUG=false
SEED_DEMO_DATA=false
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
MCP_ENABLED=false
MCP_CORS_ALLOWED_ORIGINS=

KEYCLOAK_URL=
KEYCLOAK_ISSUER_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=

CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=

PYTHON_AI_SERVICE_URL=
AGENT_EMAIL_DOMAIN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GITHUB_TOKEN=
GITHUB_ORG=
# Repositories agents must never touch, e.g. your-org/TeamFlow
AGENT_PROTECTED_REPOS=
# Local development may let workspaces use GITHUB_TOKEN; keep false for multi-tenant installs
AGENT_ALLOW_PLATFORM_GITHUB_TOKEN=true
# Local development may audit localhost pages
OUTBOUND_ALLOW_PRIVATE_HOSTS=true
ALLOW_MOCK_BILLING=false
GEMINI_API_KEY=
OPENAI_API_KEY=

# Deployment provider (deployments return 503 without a hook URL)
DEPLOY_HOOK_URL_DEV=
DEPLOY_HOOK_URL_STAGING=
DEPLOY_HOOK_URL_PRODUCTION=
DEPLOY_HOOK_SECRET=
DEPLOY_CALLBACK_BASE_URL=

LANGFUSE_DATABASE_URL=
LANGFUSE_NEXTAUTH_URL=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_UI_HOST=
LANGFUSE_PROJECT_ID=
NEXT_PUBLIC_LANGFUSE_URL=

NEST_PORT=
FRONTEND_PORT=
NODE_ENV=
FRONTEND_URL=
NEXT_PUBLIC_API_URL=
