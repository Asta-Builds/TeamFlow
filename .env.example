# Copy this file to .env and set every required value before starting Compose.
# Values are intentionally blank: no credentials, tenant names, URLs, or ports are baked into runtime config.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=
REDIS_URL=
CELERY_BROKER_URL=
# RabbitMQ AMQP Broker & Dead Letter Queue (DLQ)
RABBITMQ_URL=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_PORT=
RABBITMQ_MANAGEMENT_PORT=
RABBITMQ_MANAGEMENT_URL=

DJANGO_SECRET_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
DEBUG=false
SEED_DEMO_DATA=false
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
MCP_ENABLED=false
MCP_CORS_ALLOWED_ORIGINS=

KEYCLOAK_URL=
KEYCLOAK_ISSUER_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=

CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=

PYTHON_AI_SERVICE_URL=
AGENT_EMAIL_DOMAIN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GITHUB_TOKEN=
GITHUB_ORG=
# Repositories agents must never touch, e.g. your-org/TeamFlow
AGENT_PROTECTED_REPOS=
# Local development may let workspaces use GITHUB_TOKEN; keep false for multi-tenant installs
AGENT_ALLOW_PLATFORM_GITHUB_TOKEN=true
# Local development may audit localhost pages
OUTBOUND_ALLOW_PRIVATE_HOSTS=true
ALLOW_MOCK_BILLING=false
# Agents need at least one model provider; without one they report 503 instead of working
GEMINI_API_KEY=
# Defaults to the SDK's own default model (gemini-3.8-flash) when left empty
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Local Ollama is used only when a base URL is set
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Replay recorded model responses instead of calling a provider (tests, offline work).
# LLM_FIXTURE_DIR serves responses from disk and never contacts a provider;
# LLM_RECORD_DIR captures live responses so a run can be replayed later.
LLM_FIXTURE_DIR=
LLM_RECORD_DIR=
# GitHub endpoints (override for GitHub Enterprise)
GITHUB_API_URL=
GITHUB_WEB_URL=
# Rewrite audit targets to reach containers in local development, e.g. localhost:3000=frontend:3000
SEO_LOCAL_TARGET_REWRITES=
# Prices shown on the billing page (display only; Stripe holds the real prices)
BILLING_PRICE_LABEL_STARTER=
BILLING_PRICE_LABEL_GROWTH=
BILLING_PRICE_LABEL_ENTERPRISE=
# Demo seeding (manage.py seed_demo)
DEMO_OWNER_EMAIL=
DEMO_OWNER_NAME=
DEMO_SITE_URL=

# Deployment provider (deployments return 503 without a hook URL)
DEPLOY_HOOK_URL_DEV=
DEPLOY_HOOK_URL_STAGING=
DEPLOY_HOOK_URL_PRODUCTION=
DEPLOY_HOOK_SECRET=
DEPLOY_CALLBACK_BASE_URL=

LANGFUSE_DATABASE_URL=
LANGFUSE_NEXTAUTH_URL=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_UI_HOST=
LANGFUSE_PROJECT_ID=
NEXT_PUBLIC_LANGFUSE_URL=

NEST_PORT=
FRONTEND_PORT=
NODE_ENV=
FRONTEND_URL=
NEXT_PUBLIC_API_URL=
