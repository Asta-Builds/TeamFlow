map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}

limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=20r/m;
limit_req_status 429;

server {
    listen ${PORT};
    server_name _;
    server_tokens off;

    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 100.64.0.0/10;
    set_real_ip_from fd00::/8;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    resolver ${RESOLVER} ipv6=on valid=10s;

    set $backend_host "${BACKEND_HOST}";
    set $nest_host "${NEST_HOST}";
    set $frontend_host "${FRONTEND_HOST}";

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /mcp {
        proxy_pass http://$nest_host;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header MCP-Protocol-Version $http_mcp_protocol_version;
        proxy_set_header Mcp-Session-Id $http_mcp_session_id;
        proxy_set_header Last-Event-ID $http_last_event_id;
        proxy_read_timeout 300s;
        proxy_connect_timeout 60s;
    }

    location = /.well-known/oauth-protected-resource/mcp {
        proxy_pass http://$nest_host;
    }

    location = /.well-known/oauth-authorization-server {
        proxy_pass http://$nest_host;
    }

    location ~ ^/api/deployments/[0-9]+/provider_callback/?$ {
        proxy_pass http://$backend_host;
        proxy_http_version 1.1;
        client_max_body_size 2m;
    }

    location = /api/billing/webhook/ {
        proxy_pass http://$backend_host;
        proxy_http_version 1.1;
        client_max_body_size 1m;
    }

    location = /api/integrations/slack/events/ {
        proxy_pass http://$backend_host;
        proxy_http_version 1.1;
        client_max_body_size 1m;
    }

    location /admin/ {
        ${ADMIN_ALLOW_RULES}
        error_page 403 = @admin_forbidden;
        proxy_pass http://$backend_host;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
    }

    location /static/admin/ {
        ${ADMIN_ALLOW_RULES}
        error_page 403 = @admin_forbidden;
        proxy_pass http://$backend_host;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    location @admin_forbidden {
        default_type text/plain;
        return 403 "Admin access is restricted. Configure ADMIN_ALLOWED_IPS to enable access.\n";
    }

    location /static/ {
        proxy_pass http://$backend_host;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    location ~ ^/api/auth/(login|register|refresh|clerk|keycloak|change-password)/?$ {
        limit_req zone=auth_limit burst=20 nodelay;
        proxy_pass http://$nest_host;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }

    location ~ ^/api/agents/events/stream/?$ {
        proxy_pass http://$nest_host;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding on;
    }

    location /api/ {
        proxy_pass http://$nest_host;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    location / {
        proxy_pass http://$frontend_host;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}
