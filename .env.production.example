# TeamFlow production / pre-production environment.
# Copy to .env.production, replace every placeholder, and never commit the copy.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# See docs/PREPROD_RUNBOOK.md for the full checklist.

# --- Public URL ---------------------------------------------------------------
# The HTTPS origin users open. TLS terminates in front of the nginx container.
FRONTEND_URL=https://teamflow.example.com
ALLOWED_HOSTS=teamflow.example.com,backend,localhost
CORS_ALLOWED_ORIGINS=https://teamflow.example.com
CSRF_TRUSTED_ORIGINS=https://teamflow.example.com
NEXT_PUBLIC_API_URL=/api
# nginx publish address (keep 127.0.0.1 when a host reverse proxy terminates TLS)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# --- Secrets (each one unique, at least 32 characters) --------------------------
DJANGO_SECRET_KEY=replace-with-a-random-64-character-secret
JWT_SECRET=replace-with-a-different-random-64-character-secret
JWT_REFRESH_SECRET=replace-with-a-third-random-64-character-secret

# --- Database and queue -----------------------------------------------------------
POSTGRES_DB=teamflow
POSTGRES_USER=teamflow
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgres://teamflow:replace-with-a-strong-database-password@db:5432/teamflow
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_CONCURRENCY=2

# --- Internal service wiring --------------------------------------------------------
PYTHON_AI_SERVICE_URL=http://backend:8000

# --- Sign-in (Clerk) -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: defaults to the issuer encoded in the publishable key
CLERK_ISSUER=
# Origins allowed in the Clerk token "azp" claim (defaults to FRONTEND_URL)
CLERK_AUTHORIZED_PARTIES=https://teamflow.example.com

# --- Agents -----------------------------------------------------------------------
AGENT_EMAIL_DOMAIN=agents.teamflow.example.com
GIT_AUTHOR_NAME=TeamFlow Agents
GIT_AUTHOR_EMAIL=agents@teamflow.example.com
# Repositories agents must never pull, push, clone, or merge (the platform itself)
AGENT_PROTECTED_REPOS=your-org/TeamFlow
# Operator GitHub credentials. Tenants use them only when the flag below is true
# (single-tenant installs). Multi-tenant installs keep it false and each workspace
# connects its own GitHub integration in Settings.
GITHUB_TOKEN=
GITHUB_ORG=
AGENT_ALLOW_PLATFORM_GITHUB_TOKEN=false
# Model providers. Agents need at least one; without any, agent runs and plan
# decomposition return 503 and nothing is written.
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# GitHub endpoints; override both for GitHub Enterprise.
GITHUB_API_URL=
GITHUB_WEB_URL=

# Prices shown on the billing page (display only; Stripe holds the real prices).
BILLING_PRICE_LABEL_STARTER=
BILLING_PRICE_LABEL_GROWTH=
BILLING_PRICE_LABEL_ENTERPRISE=

# --- Deployments -------------------------------------------------------------------
# Without a hook URL, deployments and rollbacks return 503 and nothing is recorded.
DEPLOY_HOOK_URL_DEV=
DEPLOY_HOOK_URL_STAGING=
DEPLOY_HOOK_URL_PRODUCTION=
# Required when any hook URL is set; signs hook requests and provider callbacks
DEPLOY_HOOK_SECRET=
DEPLOY_CALLBACK_BASE_URL=https://teamflow.example.com

# --- Billing (Stripe) ----------------------------------------------------------------
# Without STRIPE_SECRET_KEY, checkout and the billing portal return 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# --- Integrations and observability (optional) ---------------------------------------
SLACK_SIGNING_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_UI_HOST=
LANGFUSE_PROJECT_ID=
NEXT_PUBLIC_LANGFUSE_URL=

# --- Remote MCP server (optional) ------------------------------------------------------
MCP_ENABLED=false
MCP_CORS_ALLOWED_ORIGINS=

# --- Optional -------------------------------------------------------------------------
# Expose Swagger at /api/docs in production
ENABLE_API_DOCS=false
# Image names used by compose (the deploy workflow publishes ghcr.io/<owner>/<repo>-*)
IMAGE_PREFIX=teamflow
IMAGE_TAG=local
# Legacy Keycloak SSO (unused unless configured)
KEYCLOAK_URL=
KEYCLOAK_ISSUER_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
