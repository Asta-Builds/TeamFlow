# Copy to backend/.env and adjust for your environment.

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — the Next.js frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database — leave blank to use SQLite (dev). For Postgres (prod), e.g.:
# DATABASE_URL=postgres://teamflow:password@localhost:5432/teamflow
DATABASE_URL=

# Keycloak back-channel URL can use the Docker service name. The issuer must
# exactly match the public `iss` claim carried by Keycloak tokens.
KEYCLOAK_URL=http://localhost:8080/realms/teamflow
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/teamflow
KEYCLOAK_CLIENT_ID=teamflow-app
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_HTTP_TIMEOUT_SECONDS=5

# Integrations (leave blank until configured)
SLACK_SIGNING_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
