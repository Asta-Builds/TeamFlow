# Copy to backend/.env and adjust for your environment.

# Django
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=

# CORS — the Next.js frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Database — leave blank only when deliberately using local SQLite.
DATABASE_URL=
CELERY_BROKER_URL=

# Keycloak back-channel URL can use the Docker service name. The issuer must
# exactly match the public `iss` claim carried by Keycloak tokens.
KEYCLOAK_URL=
KEYCLOAK_ISSUER_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_HTTP_TIMEOUT_SECONDS=5

# Integrations (leave blank until configured)
SLACK_SIGNING_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# Autonomous agent identity and Git commits (required only when those features are used)
AGENT_EMAIL_DOMAIN=
GIT_AUTHOR_NAME=asta-build
GIT_AUTHOR_EMAIL=abdelilahdahou10@gmail.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_UI_HOST=
LANGFUSE_PROJECT_ID=
