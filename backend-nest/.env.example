# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamflow?schema=public"

# Application Port
PORT=8001

# Required: distinct random secrets, at least 32 characters each
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Frontend & CORS
FRONTEND_URL="http://localhost:3000"

# Python AI Service Bridge
# Must match Django SIMPLE_JWT SIGNING_KEY (SECRET_KEY by default).
PYTHON_AI_JWT_SECRET=""
PYTHON_AI_SERVICE_URL="http://127.0.0.1:8000"

# Mock billing is disabled by default and never enabled in production.
# Opt-in also requires NODE_ENV=development or NODE_ENV=test.
ALLOW_MOCK_BILLING=false

# Keycloak (Optional SSO)
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="teamflow"
KEYCLOAK_CLIENT_ID="teamflow-client"
