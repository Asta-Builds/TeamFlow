# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamflow?schema=public"

# Application Port
PORT=8001

# JWT Secrets (Ensure strong random keys in production)
JWT_SECRET="teamflow-secret-key-super-secure-change-in-prod"
JWT_REFRESH_SECRET="teamflow-refresh-secret-super-secure"

# Frontend & CORS
FRONTEND_URL="http://localhost:3000"

# Python AI Service Bridge
PYTHON_AI_SERVICE_URL="http://127.0.0.1:8000"

# Keycloak (Optional SSO)
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="teamflow"
KEYCLOAK_CLIENT_ID="teamflow-client"
