# Database Connection (PostgreSQL)
DATABASE_URL=""

# Application Port
PORT=
NODE_ENV=

# Required: distinct random secrets, at least 32 characters each
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Frontend & CORS
FRONTEND_URL=""
CORS_ALLOWED_ORIGINS=""

# Python AI Service Bridge
# Must match Django SIMPLE_JWT SIGNING_KEY (SECRET_KEY by default).
PYTHON_AI_JWT_SECRET=""
PYTHON_AI_SERVICE_URL=""
AGENT_EMAIL_DOMAIN=""

# Mock billing is disabled by default and never enabled in production.
# Opt-in also requires NODE_ENV=development or NODE_ENV=test.
ALLOW_MOCK_BILLING=false

# Keycloak (Optional SSO)
KEYCLOAK_URL=""
KEYCLOAK_ISSUER_URL=""
KEYCLOAK_REALM=""
KEYCLOAK_CLIENT_ID=""
